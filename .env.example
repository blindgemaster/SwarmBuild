# ──────────────────────────────────────────
# Swarmforge Environment Variables
# Copy to .env and fill in your values
# ──────────────────────────────────────────

# Supabase (hosted — get from supabase.com dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# Anthropic (for harness-gen plan generation only)
ANTHROPIC_API_KEY=sk-ant-...your-key

# GitHub OAuth App (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub org for job repos (repos created as org/job-id)
GITHUB_ORG=AgentTogether

# Redis (default for Docker Compose)
REDIS_URL=redis://localhost:6379

# Frontend public vars
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
