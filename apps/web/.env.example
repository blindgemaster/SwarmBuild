# Supabase (same project URL and anon key as the API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL (optional — defaults to https://swarmbuild.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Dev token for local development without OAuth (optional)
NEXT_PUBLIC_DEV_TOKEN=dev-token-swarmbuild-test
