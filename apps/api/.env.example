# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# AI providers (plan generation — HuggingFace primary, Groq fallback)
HUGGING_FACE_TOKEN=your-hf-token
GROQ_API_KEY=your-groq-api-key

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub repo provisioning (optional — Personal Access Token with repo scope)
GITHUB_TOKEN=
GITHUB_ORG=swarmbuild-jobs

# Redis (optional — defaults to localhost)
REDIS_URL=redis://localhost:6379

# Frontend URL for CORS (Vercel preview URLs are auto-allowed via regex)
FRONTEND_URL=http://localhost:3000
# PRODUCTION: FRONTEND_URL=https://swarm-build-web.vercel.app

# API URL (used in CORS allowed origins)
API_URL=http://localhost:8000
# PRODUCTION: API_URL=https://swarmbuild.onrender.com

# Dev mode — bypasses auth for local development
# MUST be false in production
DEV_MODE=true

# JWT secret for worker tokens — use a strong random value in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
